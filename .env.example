# Environment Configuration for AI Business Location Selector
# Note: The application is designed to function out-of-the-box using public OpenStreetMap Overpass API
# and offline demographic/census datasets without requiring paid API keys.

# Optional Overpass API endpoint (defaults to official public server)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Application Environment (development, testing, production)
APP_ENV=development

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache directory for external geospatial queries
DATA_CACHE_DIR=./data/raw/osm/cache
